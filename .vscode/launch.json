	"version": "0.2.0",
	"configurations": [
		{
			"args": [
				"${workspaceFolder}/.vscode-test",
				"--extensionDevelopmentPath=${workspaceFolder}",
				// "--extensionTestsPath=${workspaceFolder}/out/extension.js"
			],
			"name": "Launch Extension",
			"outFiles": [
				"${workspaceFolder}/out/**/*.js",
				"!**/node_modules/**"
			],
			"preLaunchTask": "npm: compile",
			"request": "launch",
			"type": "extensionHost",
		}
	]
}